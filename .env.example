# Copie este arquivo para .env e preencha os valores.
# O .env nunca deve ser versionado (ja esta no .gitignore).

# ===== Banco de dados (MySQL) =====
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== Autenticacao da API =====
# Formato: chave:nome, varios pares separados por virgula.
# Exemplo: API_KEYS=chave_do_pc_natan:pc_natan,chave_da_loja_01:loja_01
# Gere cada chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
